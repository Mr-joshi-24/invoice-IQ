# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME="Invoice IQ"
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Connection
# For local dev: sqlite:///./data/documind.db
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/invoice_iq
DATABASE_URL=sqlite:///./data/documind.db

# Storage Paths
UPLOAD_DIR=./data/uploads
PROCESSED_PAGES_DIR=./data/processed_pages
ML_ARTIFACTS_DIR=./ml/artifacts

# Model & Decision Thresholds
CONFIDENCE_THRESHOLD=0.80
ANOMALY_CONTAMINATION=0.05
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=["pdf", "png", "jpg", "jpeg"]

